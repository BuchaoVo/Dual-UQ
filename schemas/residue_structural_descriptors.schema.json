{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dual-uq.org/schemas/residue_structural_descriptors.schema.json",
  "title": "ResidueStructuralDescriptors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pair_id",
    "canonical_position",
    "ca_displacement",
    "local_pairwise_distance_change",
    "neighborhood_geometry_change",
    "contact_gain",
    "contact_loss",
    "descriptor_method",
    "descriptor_version"
  ],
  "properties": {
    "pair_id": {
      "type": "string"
    },
    "canonical_position": {
      "type": "integer",
      "minimum": 1
    },
    "ca_displacement": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "local_pairwise_distance_change": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "neighborhood_geometry_change": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "contact_gain": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "contact_loss": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "descriptor_method": {
      "type": "string"
    },
    "descriptor_version": {
      "type": "string"
    }
  },
  "x-primary-key": [
    "pair_id",
    "canonical_position"
  ],
  "x-foreign-keys": [
    {
      "field": "pair_id",
      "references": "condition_pairs.pair_id"
    }
  ]
}
