# ============================================================
# Repository-local directories
# ============================================================

# Documentation / reports / runtime outputs kept locally only
/docs/
/reports/
/runs/
/tmp/
/artifacts/


# ============================================================
# Local configuration
# ============================================================

/configs/local/
/configs/paths.yaml
*.local.yaml

.env
.env.*


# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]
*.egg-info/

.pytest_cache/
.mypy_cache/
.ruff_cache/

.venv/
build/
dist/
wandb/


# ============================================================
# Runtime / temporary files
# ============================================================

*.log
*.pid
*.lock
*.tmp

experiments/**/logs/
experiments/**/outputs/
experiments/**/metrics/


# ============================================================
# Raw and intermediate data
# ============================================================

/data/raw/
/data/interim/


# ============================================================
# Large processed assets
# ============================================================

/data/processed/

# Explicit patterns retained for clarity if processed data
# policy is relaxed in the future.
data/processed/**/*.pdb
data/processed/**/*.cif
data/processed/**/*.mmcif
data/processed/**/*.npz
data/processed/**/*.pt
data/processed/**/*.pth


# ============================================================
# Generated manifests / large tables
# ============================================================

data/manifests/*.parquet
data/manifests/*.csv


# ============================================================
# Checkpoints and generated third-party outputs
# ============================================================

/artifacts/checkpoints/
/checkpoints/

third_party/ProteinMPNN/outputs/
third_party/ProteinMPNN/training/*/checkpoints/
third_party/ProteinMPNN/training/*/logs/


# ============================================================
# Notebook / editor / OS
# ============================================================

.ipynb_checkpoints/
.vscode/
.idea/

.DS_Store
Thumbs.db


# ============================================================
# Keep versioned scientific fixtures / definitions
# ============================================================

!data/manifests/
!data/manifests/**

!data/fixtures/
!data/fixtures/**

!tests/fixtures/
!tests/fixtures/**


# ============================================================
# Reconstructible artifact state
# ============================================================

/artifacts/audits/
/artifacts/metrics/
/artifacts/reports/

# Rebuildable large Apo/Holo local-response tables
/experiments/interventions/biological_states/apo_holo/cross_model_local_response/esm_if1/position_local_response.parquet
/experiments/interventions/biological_states/apo_holo/cross_model_local_response/proteinmpnn/position_local_response.parquet
