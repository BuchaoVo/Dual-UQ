{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dual-uq.org/schemas/sequence_ensemble_manifest.schema.json",
  "title": "StructCalSequenceEnsembleManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_version", "model_id", "checkpoint_id", "pair_id", "protein_id",
    "identity_cluster_id", "split", "track", "arm", "state_family",
    "condition_structure_id", "condition_label", "condition_position",
    "sequence_instance_id", "seed_id", "generated_sequence",
    "target_sequence_length", "sequence_comparable", "generation_protocol_id",
    "source_artifact", "source_run_id", "source_record_id", "model_environment",
    "generation_semantics", "temperature_semantics", "historical_reuse_class",
    "ingest_version", "asset_class"
  ],
  "properties": {
    "benchmark_version": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "checkpoint_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "pair_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "protein_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "identity_cluster_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "split": {"anyOf": [{"enum": ["TRAIN", "VALIDATION", "LOCKED_TEST"]}, {"type": "null"}]},
    "track": {"anyOf": [{"enum": ["TRACK_I_STRUCTURAL_INVARIANCE", "TRACK_II_FUNCTIONAL_SENSITIVITY"]}, {"type": "null"}]},
    "arm": {"anyOf": [{"enum": ["representation_variation", "ligand_state", "functional_state"]}, {"type": "null"}]},
    "state_family": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "condition_structure_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "condition_label": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "condition_position": {"anyOf": [{"enum": [1, 2]}, {"type": "null"}]},
    "sequence_instance_id": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "seed_id": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "generated_sequence": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "target_sequence_length": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
    "sequence_comparable": {"type": "boolean"},
    "generation_protocol_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "source_artifact": {"type": "string", "minLength": 1},
    "source_run_id": {"type": "string", "minLength": 1},
    "source_record_id": {"type": "string", "minLength": 1},
    "model_environment": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "generation_semantics": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "temperature_semantics": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "historical_reuse_class": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "ingest_version": {"type": "string", "minLength": 1},
    "asset_class": {"enum": ["FORMAL_ANALYSIS_READY", "DIAGNOSTIC_ONLY", "REJECTED_FOR_ANALYSIS", "MISSING"]}
  },
  "x-primary-key": ["model_id", "source_run_id", "source_record_id"],
  "x-version": "structcal_v1_sequence_ensemble_manifest_v1"
}
