{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dual-uq.org/schemas/sequence_ensemble_exclusions.schema.json",
  "title": "StructCalSequenceEnsembleExclusions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_version", "model_id", "pair_id", "protein_id", "identity_cluster_id",
    "split", "track", "arm", "state_family", "condition_structure_id",
    "condition_label", "condition_position", "observed_instances", "source_artifact",
    "source_run_id", "asset_class", "failure_reason", "ingest_version"
  ],
  "properties": {
    "benchmark_version": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": "string", "minLength": 1},
    "protein_id": {"type": "string", "minLength": 1},
    "identity_cluster_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["TRAIN", "VALIDATION", "LOCKED_TEST"]},
    "track": {"enum": ["TRACK_I_STRUCTURAL_INVARIANCE", "TRACK_II_FUNCTIONAL_SENSITIVITY"]},
    "arm": {"enum": ["representation_variation", "ligand_state", "functional_state"]},
    "state_family": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "condition_structure_id": {"type": "string", "minLength": 1},
    "condition_label": {"type": "string", "minLength": 1},
    "condition_position": {"enum": [1, 2]},
    "observed_instances": {"type": "integer", "minimum": 0},
    "source_artifact": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "source_run_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "asset_class": {"enum": ["FORMAL_ANALYSIS_READY", "DIAGNOSTIC_ONLY", "REJECTED_FOR_ANALYSIS", "MISSING"]},
    "failure_reason": {"type": "string", "minLength": 1},
    "ingest_version": {"type": "string", "minLength": 1}
  },
  "x-primary-key": ["model_id", "pair_id", "condition_structure_id"],
  "x-version": "structcal_v1_sequence_ensemble_exclusions_v1"
}
