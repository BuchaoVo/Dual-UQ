{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dual-uq.org/schemas/sequence_scores.schema.json",
  "title": "SequenceScores",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence_id",
    "sequence_sha256",
    "generator_model_id",
    "evaluator_model_id",
    "evaluator_role",
    "pair_id",
    "target_condition_structure_id",
    "raw_score",
    "score_direction",
    "wt_reference_score",
    "baseline_adjusted_score",
    "score_semantics"
  ],
  "properties": {
    "sequence_id": {
      "type": "string"
    },
    "sequence_sha256": {
      "type": "string"
    },
    "generator_model_id": {
      "type": "string"
    },
    "evaluator_model_id": {
      "type": "string"
    },
    "evaluator_role": {
      "type": "string",
      "enum": [
        "SELF",
        "REFERENCE_PROTEINMPNN",
        "REFERENCE_ESM_IF1"
      ]
    },
    "pair_id": {
      "type": "string"
    },
    "target_condition_structure_id": {
      "type": "string"
    },
    "raw_score": {
      "type": "number"
    },
    "score_direction": {
      "type": "string"
    },
    "wt_reference_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "baseline_adjusted_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "score_semantics": {
      "type": "string"
    }
  },
  "x-primary-key": [
    "sequence_id",
    "evaluator_model_id",
    "target_condition_structure_id"
  ],
  "x-foreign-keys": [
    {
      "field": "pair_id",
      "references": "condition_pairs.pair_id"
    },
    {
      "field": "target_condition_structure_id",
      "references": "structures.structure_id"
    }
  ],
  "x-invariants": [
    "generator and evaluator identities are both required",
    "ProteinMPNN and ESM-IF1 raw score scales are not averaged"
  ]
}
