{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dual-uq.org/schemas/generated_sequences.schema.json",
  "title": "GeneratedSequences",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "model_version",
    "checkpoint_id",
    "pair_id",
    "condition_structure_id",
    "sample_id",
    "seed",
    "temperature",
    "decoding_protocol",
    "sequence",
    "sequence_sha256"
  ],
  "properties": {
    "model_id": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "checkpoint_id": {
      "type": "string"
    },
    "pair_id": {
      "type": "string"
    },
    "condition_structure_id": {
      "type": "string"
    },
    "sample_id": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "temperature": {
      "type": "number",
      "minimum": 0
    },
    "decoding_protocol": {
      "type": "string"
    },
    "sequence": {
      "type": "string"
    },
    "sequence_sha256": {
      "type": "string"
    }
  },
  "x-primary-key": [
    "model_id",
    "checkpoint_id",
    "pair_id",
    "condition_structure_id",
    "sample_id"
  ],
  "x-foreign-keys": [
    {
      "field": "pair_id",
      "references": "condition_pairs.pair_id"
    },
    {
      "field": "condition_structure_id",
      "references": "structures.structure_id"
    }
  ]
}
