{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dual-uq.org/schemas/sequence_ensemble_readiness.schema.json",
  "title": "StructCalSequenceEnsembleReadiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_version", "model_id", "pair_id", "protein_id", "identity_cluster_id",
    "split", "track", "arm", "state_family", "condition_structure_id",
    "condition_label", "condition_position", "expected_instances", "observed_instances",
    "expected_seed_count", "observed_seed_count", "missing_seed_count",
    "duplicate_seed_count", "unexpected_seed_count", "observed_source",
    "identity_integrity_pass", "sequence_integrity_pass", "protocol_integrity_pass",
    "asset_class", "failure_reason", "ingest_version"
  ],
  "properties": {
    "benchmark_version": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": "string", "minLength": 1},
    "protein_id": {"type": "string", "minLength": 1},
    "identity_cluster_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["TRAIN", "VALIDATION", "LOCKED_TEST"]},
    "track": {"enum": ["TRACK_I_STRUCTURAL_INVARIANCE", "TRACK_II_FUNCTIONAL_SENSITIVITY"]},
    "arm": {"enum": ["representation_variation", "ligand_state", "functional_state"]},
    "state_family": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "condition_structure_id": {"type": "string", "minLength": 1},
    "condition_label": {"type": "string", "minLength": 1},
    "condition_position": {"enum": [1, 2]},
    "expected_instances": {"type": "integer", "minimum": 0},
    "observed_instances": {"type": "integer", "minimum": 0},
    "expected_seed_count": {"type": "integer", "minimum": 0},
    "observed_seed_count": {"type": "integer", "minimum": 0},
    "missing_seed_count": {"type": "integer", "minimum": 0},
    "duplicate_seed_count": {"type": "integer", "minimum": 0},
    "unexpected_seed_count": {"type": "integer", "minimum": 0},
    "observed_source": {"type": "boolean"},
    "identity_integrity_pass": {"type": "boolean"},
    "sequence_integrity_pass": {"type": "boolean"},
    "protocol_integrity_pass": {"type": "boolean"},
    "asset_class": {"enum": ["FORMAL_ANALYSIS_READY", "DIAGNOSTIC_ONLY", "REJECTED_FOR_ANALYSIS", "MISSING"]},
    "failure_reason": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "ingest_version": {"type": "string", "minLength": 1}
  },
  "x-primary-key": ["model_id", "pair_id", "condition_structure_id"],
  "x-version": "structcal_v1_sequence_ensemble_readiness_v1"
}
