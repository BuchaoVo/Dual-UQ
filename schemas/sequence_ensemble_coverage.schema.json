{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dual-uq.org/schemas/sequence_ensemble_coverage.schema.json",
  "title": "StructCalSequenceEnsembleCoverage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_version", "model_id", "cohort", "track", "arm", "state_family",
    "requested_pairs", "candidate_pairs", "formal_ready_pairs",
    "diagnostic_only_pairs", "rejected_pairs", "missing_pairs",
    "requested_conditions", "observed_conditions", "formal_ready_conditions",
    "diagnostic_only_conditions", "rejected_conditions", "missing_conditions",
    "requested_proteins", "requested_identity_clusters",
    "observed_sequence_instances", "ingest_version"
  ],
  "properties": {
    "benchmark_version": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "cohort": {"enum": ["TRACK_I", "APO_HOLO", "OPEN_CLOSED", "INWARD_OUTWARD", "ACTIVE_INACTIVE", "RESTING_ACTIVATED"]},
    "track": {"enum": ["TRACK_I_STRUCTURAL_INVARIANCE", "TRACK_II_FUNCTIONAL_SENSITIVITY"]},
    "arm": {"enum": ["representation_variation", "ligand_state", "functional_state"]},
    "state_family": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "requested_pairs": {"type": "integer", "minimum": 0},
    "candidate_pairs": {"type": "integer", "minimum": 0},
    "formal_ready_pairs": {"type": "integer", "minimum": 0},
    "diagnostic_only_pairs": {"type": "integer", "minimum": 0},
    "rejected_pairs": {"type": "integer", "minimum": 0},
    "missing_pairs": {"type": "integer", "minimum": 0},
    "requested_conditions": {"type": "integer", "minimum": 0},
    "observed_conditions": {"type": "integer", "minimum": 0},
    "formal_ready_conditions": {"type": "integer", "minimum": 0},
    "diagnostic_only_conditions": {"type": "integer", "minimum": 0},
    "rejected_conditions": {"type": "integer", "minimum": 0},
    "missing_conditions": {"type": "integer", "minimum": 0},
    "requested_proteins": {"type": "integer", "minimum": 0},
    "requested_identity_clusters": {"type": "integer", "minimum": 0},
    "observed_sequence_instances": {"type": "integer", "minimum": 0},
    "ingest_version": {"type": "string", "minLength": 1}
  },
  "x-primary-key": ["model_id", "cohort"],
  "x-version": "structcal_v1_sequence_ensemble_coverage_v1"
}
