{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dual-uq.org/schemas/pair_structural_descriptors.schema.json",
  "title": "PairStructuralDescriptors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pair_id",
    "aligned_ca_rmsd",
    "median_residue_displacement",
    "upper_tail_residue_displacement",
    "global_contact_change",
    "descriptor_method",
    "descriptor_version"
  ],
  "properties": {
    "pair_id": {
      "type": "string"
    },
    "aligned_ca_rmsd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "median_residue_displacement": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "upper_tail_residue_displacement": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "global_contact_change": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "descriptor_method": {
      "type": "string"
    },
    "descriptor_version": {
      "type": "string"
    }
  },
  "x-primary-key": [
    "pair_id"
  ],
  "x-foreign-keys": [
    {
      "field": "pair_id",
      "references": "condition_pairs.pair_id"
    }
  ]
}
